# Optional: hosted form URLs (Getform, Formspree, Formcarry, Netlify Forms HTTPS endpoint…)
# If VITE_APPOINTMENT_FORM_URL is empty, patrons get a prefilled mailto:+ local backup copy.
VITE_APPOINTMENT_FORM_URL=

# Optional override; defaults to bundled Getform URL for compatibility.
VITE_CONTACT_FORM_URL=

# Used when opening mailto fallbacks
VITE_CLINIC_EMAIL=bookings@hopeclinic.health
